# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Database
DATABASE_URL=postgresql://aetherdust:changeme@localhost:5432/aetherdust

# Auth
JWT_SECRET=changeme-set-a-long-random-string-in-production
ADMIN_EMAIL=admin@aetherdust.local
ADMIN_PASSWORD=changeme

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_WINDOW_MS=1000

# Metrics (optional - if set, /metrics requires Bearer token)
METRICS_API_KEY=

# Midnight network (required for live mode)
MIDNIGHT_NETWORK_ENDPOINT=
MIDNIGHT_NETWORK_ID=undeployed
MIDNIGHT_INDEXER_ENDPOINT=
MIDNIGHT_INDEXER_WS_ENDPOINT=
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
MIDNIGHT_FAUCET=
SPONSOR_WALLET_SEED=
SPONSOR_WALLET_MNEMONIC=
